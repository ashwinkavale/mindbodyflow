# Server-only Gemini integration. Do not prefix this key with NEXT_PUBLIC_.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Where the "Sign up" button leads. Leave unset to use the tracker built into this site at /tracker.
# For local development run the tracker's own dev server and use:
# NEXT_PUBLIC_TRACKER_URL=http://localhost:5173
