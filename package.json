{
  "name": "mindbodyflow-rotational-training",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:tracker": "npm --prefix rts-tracker run dev",
    "build:tracker": "npm --prefix rts-tracker install --no-audit --no-fund && npm --prefix rts-tracker run build -- --base=/tracker/ --outDir ../public/tracker --emptyOutDir",
    "build": "npm run build:tracker && next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "unrs-resolver@1.11.1": true
  }
}
